{
  "workbench.sideBar.location": "right",
  "workbench.colorTheme": "Vira Graphene",
  "files.associations": {
    "*.service.ts": "typescript",
    "*.css": "tailwindcss"
  },
  "workbench.colorCustomizations": {
    "[Vira Graphene]": {
      "sideBar.border": "#333333",
      "panel.border": "#333333"
    },
    "[Vira*]": {
      "statusBar.debuggingBackground": "#39EA5F33",
      "statusBar.debuggingForeground": "#39EA5F",
      "toolbar.activeBackground": "#39EA5F26",
      "button.background": "#39EA5F",
      "button.hoverBackground": "#39EA5Fcc",
      "extensionButton.separator": "#39EA5F33",
      "extensionButton.background": "#39EA5F14",
      "extensionButton.foreground": "#39EA5F",
      "extensionButton.hoverBackground": "#39EA5F33",
      "extensionButton.prominentForeground": "#39EA5F",
      "extensionButton.prominentBackground": "#39EA5F14",
      "extensionButton.prominentHoverBackground": "#39EA5F33",
      "activityBarBadge.background": "#39EA5F",
      "activityBar.activeBorder": "#39EA5F",
      "activityBarTop.activeBorder": "#39EA5F",
      "list.inactiveSelectionIconForeground": "#39EA5F",
      "list.activeSelectionForeground": "#39EA5F",
      "list.inactiveSelectionForeground": "#39EA5F",
      "list.highlightForeground": "#39EA5F",
      "sash.hoverBorder": "#39EA5F80",
      "list.activeSelectionIconForeground": "#39EA5F",
      "scrollbarSlider.activeBackground": "#39EA5F80",
      "editorSuggestWidget.highlightForeground": "#39EA5F",
      "textLink.foreground": "#39EA5F",
      "progressBar.background": "#39EA5F",
      "pickerGroup.foreground": "#39EA5F",
      "tab.activeBorder": "#39EA5F",
      "tab.activeBorderTop": "#39EA5F00",
      "tab.unfocusedActiveBorder": "#39EA5F",
      "tab.unfocusedActiveBorderTop": "#39EA5F00",
      "tab.activeModifiedBorder": "#39EA5F00",
      "notificationLink.foreground": "#39EA5F",
      "editorWidget.resizeBorder": "#39EA5F",
      "editorWidget.border": "#39EA5F",
      "settings.modifiedItemIndicator": "#39EA5F",
      "panelTitle.activeBorder": "#39EA5F",
      "breadcrumb.activeSelectionForeground": "#39EA5F",
      "menu.selectionForeground": "#39EA5F",
      "menubar.selectionForeground": "#39EA5F",
      "editor.findMatchBorder": "#39EA5F",
      "selection.background": "#39EA5F40",
      "statusBarItem.remoteBackground": "#39EA5F14",
      "statusBarItem.remoteHoverBackground": "#39EA5F",
      "statusBarItem.remoteForeground": "#39EA5F",
      "notebook.inactiveFocusedCellBorder": "#39EA5F80",
      "chat.slashCommandForeground": "#39EA5F",
      "chat.avatarForeground": "#39EA5F",
      "activityBarBadge.foreground": "#000000",
      "button.foreground": "#000000",
      "statusBarItem.remoteHoverForeground": "#000000"
    }
  },
  "editor.fontFamily": "'CaskaydiaCove Nerd Font', 'Droid Sans Mono', 'monospace', monospace",
  "workbench.iconTheme": "vira-icons-graphene",
  "workbench.startupEditor": "none",
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "quotick.showWelcomeMessage": false,
  "viraTheme.accent": "Lime",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "chat.disableAIFeatures": true,
}
